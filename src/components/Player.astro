---
const iconButton =
  "inline-flex size-11 items-center justify-center rounded-full text-foreground transition-colors duration-150 hover:bg-accent hover:text-accent-foreground";
---

<section
  id="player"
  aria-label="Audio player"
  hidden
  class="fixed inset-x-0 bottom-0 z-20 border-t bg-surface pb-[env(safe-area-inset-bottom)] text-surface-foreground"
>
  <div class="mx-auto w-full max-w-3xl px-4 pt-3 pb-2 sm:px-6">
    <div class="flex items-center gap-3">
      <div class="min-w-0 flex-1">
        <p data-player-title class="truncate font-medium"></p>
        <p
          data-player-subtitle
          class="truncate text-muted-foreground text-sm"
        >
        </p>
      </div>
      <button
        type="button"
        data-player-speed
        class="inline-flex h-9 min-w-14 items-center justify-center rounded-md border border-input px-2 font-medium font-mono text-sm tabular-nums transition-colors duration-150 hover:bg-accent hover:text-accent-foreground"
      >
        1×
      </button>
    </div>

    <div class="mt-2 flex items-center gap-3">
      <span
        data-player-current
        class="w-14 font-mono text-muted-foreground text-xs tabular-nums"
        >0:00</span
      >
      <input
        type="range"
        data-player-seek
        min="0"
        max="0"
        step="1"
        value="0"
        aria-label="Position"
        class="h-2 flex-1 cursor-pointer accent-primary"
      />
      <span
        data-player-remaining
        class="w-14 text-right font-mono text-muted-foreground text-xs tabular-nums"
        >-0:00</span
      >
    </div>

    <div class="mt-1 flex items-center justify-center gap-6">
      <button
        type="button"
        data-player-back
        aria-label="Back 15 seconds"
        class={iconButton}
      >
        <svg viewBox="0 0 24 24" class="size-7" aria-hidden="true">
          <path
            d="M3 12a9 9 0 1 0 3-6.7M3 4v4.5h4.5"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
          <text
            x="12.5"
            y="15.5"
            text-anchor="middle"
            font-size="7.5"
            font-weight="700"
            fill="currentColor">15</text
          >
        </svg>
      </button>
      <button
        type="button"
        data-player-toggle
        aria-label="Play"
        class="inline-flex size-14 items-center justify-center rounded-full bg-primary text-primary-foreground transition-colors duration-150 hover:bg-primary/90"
      >
        <svg
          data-icon-play
          viewBox="0 0 24 24"
          class="size-7"
          aria-hidden="true"
        >
          <path d="M8 5.5v13l10.5-6.5L8 5.5Z" fill="currentColor"></path>
        </svg>
        <svg
          data-icon-pause
          viewBox="0 0 24 24"
          class="hidden size-7"
          aria-hidden="true"
        >
          <path d="M7 5h3.5v14H7zM13.5 5H17v14h-3.5z" fill="currentColor"
          ></path>
        </svg>
      </button>
      <button
        type="button"
        data-player-forward
        aria-label="Forward 30 seconds"
        class={iconButton}
      >
        <svg viewBox="0 0 24 24" class="size-7" aria-hidden="true">
          <path
            d="M21 12a9 9 0 1 1-3-6.7M21 4v4.5h-4.5"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
          <text
            x="11.5"
            y="15.5"
            text-anchor="middle"
            font-size="7.5"
            font-weight="700"
            fill="currentColor">30</text
          >
        </svg>
      </button>
    </div>
    <p
      data-player-status
      role="status"
      class="min-h-5 text-center text-muted-foreground text-xs"
    >
    </p>
  </div>
  <!-- biome-ignore lint/a11y/useMediaCaption: sermon recordings have no transcripts to caption with -->
  <audio data-player-audio preload="metadata"></audio>
</section>

<script>
  import { initPlayer } from "@/scripts/player";

  initPlayer();
</script>
