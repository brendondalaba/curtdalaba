---
import { MAX_UPLOAD_MB } from "@/lib/sermons";
import { buttonPrimary, inputClass, labelClass } from "@/lib/ui";

const today = new Date().toISOString().slice(0, 10);
---

<form data-upload-form class="mt-4 grid gap-4 sm:grid-cols-2" novalidate>
  <div class="flex flex-col gap-2 sm:col-span-2">
    <label for="upload-file" class={labelClass}>Audio file</label>
    <input
      id="upload-file"
      name="file"
      type="file"
      accept="audio/*"
      required
      aria-describedby="upload-file-hint"
      class="w-full rounded-md border border-input bg-background p-2 text-sm file:mr-3 file:rounded-md file:border-0 file:bg-secondary file:px-3 file:py-1.5 file:font-medium file:text-secondary-foreground"
    />
    <p id="upload-file-hint" class="text-muted-foreground text-sm">
      MP3 or M4A, up to {MAX_UPLOAD_MB} MB.
    </p>
  </div>
  <div class="flex flex-col gap-2 sm:col-span-2">
    <label for="upload-title" class={labelClass}>Title</label>
    <input
      id="upload-title"
      name="title"
      type="text"
      maxlength="200"
      autocomplete="off"
      required
      class={inputClass}
    />
  </div>
  <div class="flex flex-col gap-2">
    <label for="upload-scripture" class={labelClass}>Scripture (optional)</label
    >
    <input
      id="upload-scripture"
      name="scripture"
      type="text"
      maxlength="200"
      autocomplete="off"
      placeholder="e.g. John 3:1–21"
      class={inputClass}
    />
  </div>
  <div class="flex flex-col gap-2">
    <label for="upload-date" class={labelClass}>Date preached</label>
    <input
      id="upload-date"
      name="preached_on"
      type="date"
      value={today}
      autocomplete="off"
      required
      class={inputClass}
    />
  </div>
  <div class="flex flex-col gap-3 sm:col-span-2">
    <progress
      data-upload-progress
      max="100"
      value="0"
      hidden
      class="h-2 w-full accent-primary"></progress>
    <p data-upload-status role="status" class="text-sm empty:hidden"></p>
    <div>
      <button type="submit" class={buttonPrimary}>Upload sermon</button>
    </div>
  </div>
</form>

<script>
  import { uploadSermon } from "@/scripts/upload";

  const form = document.querySelector<HTMLFormElement>("[data-upload-form]");
  const progress = document.querySelector<HTMLProgressElement>(
    "[data-upload-progress]"
  );
  const status = document.querySelector<HTMLElement>("[data-upload-status]");

  form?.addEventListener("submit", async event => {
    event.preventDefault();
    if (!progress || !status) return;
    const button = form.querySelector<HTMLButtonElement>("button[type=submit]");
    if (button?.getAttribute("aria-disabled") === "true") return;
    if (!form.reportValidity()) return;

    const data = new FormData(form);
    const file = data.get("file");
    if (!(file instanceof File) || file.size === 0) {
      status.textContent = "Choose an audio file.";
      return;
    }

    button?.setAttribute("aria-disabled", "true");
    progress.hidden = false;
    progress.value = 0;
    status.textContent = "Uploading…";

    // Uploads can take minutes; warn before leaving mid-way.
    const warn = (e: BeforeUnloadEvent) => e.preventDefault();
    window.addEventListener("beforeunload", warn);

    try {
      await uploadSermon({
        file,
        title: String(data.get("title") ?? ""),
        scripture: String(data.get("scripture") ?? ""),
        preachedOn: String(data.get("preached_on") ?? ""),
        onProgress: fraction => {
          progress.value = Math.round(fraction * 100);
          status.textContent = `Uploading… ${Math.round(fraction * 100)}%`;
        },
      });
      window.removeEventListener("beforeunload", warn);
      window.location.assign("/admin?notice=uploaded");
    } catch (error) {
      window.removeEventListener("beforeunload", warn);
      status.textContent =
        error instanceof Error ? error.message : "Upload failed. Try again.";
      progress.hidden = true;
      button?.removeAttribute("aria-disabled");
    }
  });
</script>
