---
type Props = { class?: string };
const { class: className } = Astro.props;
---

<!-- Sound-wave mark, same as public/favicon.svg and the app icons, drawn in theme tokens. -->
<svg
  viewBox="0 0 32 32"
  class:list={["shrink-0", className]}
  aria-hidden="true"
  focusable="false"
>
  <rect width="32" height="32" rx="7" class="fill-primary"></rect>
  <path
    d="M9 13v6M12.5 10v12M16 7v18M19.5 10v12M23 13v6"
    fill="none"
    stroke-width="2.4"
    stroke-linecap="round"
    class="stroke-primary-foreground"></path>
</svg>
