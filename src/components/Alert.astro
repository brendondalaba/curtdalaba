---
type Props = {
  tone?: "danger" | "success";
  message?: string | null;
};

const { tone = "danger", message } = Astro.props;
---

{
  message && (
    <p
      role={tone === "danger" ? "alert" : "status"}
      class:list={[
        "rounded-md px-3 py-2 text-sm",
        tone === "danger" && "bg-danger text-danger-foreground",
        tone === "success" && "bg-success text-success-foreground",
      ]}
    >
      {message}
    </p>
  )
}
