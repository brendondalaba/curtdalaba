---
import Logo from "@/components/Logo.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";

type Props = {
  title: string;
  /** Leaves room at the bottom for the sticky audio player. */
  hasPlayer?: boolean;
};

const { title, hasPlayer = false } = Astro.props;
const { isAdmin } = Astro.locals;
const path = Astro.url.pathname.replace(/\/$/, "") || "/";

const links: { href: string; label: string; icon?: "account" }[] = [
  { href: "/", label: "Sermons" },
  ...(isAdmin ? [{ href: "/admin", label: "Admin" }] : []),
  { href: "/account", label: "Account", icon: "account" },
];
---

<BaseLayout title={title}>
  <header
    class="sticky top-0 z-10 border-b bg-background/90 pt-[env(safe-area-inset-top)] backdrop-blur"
  >
    <div
      class="mx-auto flex h-14 w-full max-w-3xl items-center justify-between gap-2 px-4 sm:gap-4 sm:px-6"
    >
      <a
        href="/"
        class="flex shrink-0 items-center gap-2 whitespace-nowrap font-semibold"
      >
        <Logo class="size-8 shrink-0" />
        <span>Curt Dalaba</span>
      </a>
      <nav aria-label="Main">
        <ul class="flex items-center sm:gap-1">
          {
            links.map(link => (
              <li>
                <a
                  href={link.href}
                  aria-current={path === link.href ? "page" : undefined}
                  aria-label={link.icon ? link.label : undefined}
                  title={link.icon ? link.label : undefined}
                  class:list={[
                    "inline-flex h-9 items-center justify-center whitespace-nowrap rounded-md font-medium text-muted-foreground text-sm transition-colors duration-150 hover:bg-accent hover:text-accent-foreground aria-[current=page]:text-foreground",
                    link.icon ? "w-9" : "px-1.5 sm:px-3",
                  ]}
                >
                  {link.icon === "account" ? (
                    <svg
                      viewBox="0 0 24 24"
                      class="size-5"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <circle cx="12" cy="12" r="9.5" />
                      <circle cx="12" cy="10" r="3" />
                      <path d="M6.5 18.5a6.5 6.5 0 0 1 11 0" />
                    </svg>
                  ) : (
                    link.label
                  )}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </header>
  <main
    class:list={[
      "mx-auto w-full max-w-3xl flex-1 px-4 pt-8 sm:px-6 sm:pt-12",
      // Clears the fixed player; player.ts keeps --player-height current.
      hasPlayer
        ? "pb-[calc(var(--player-height,0px)+4rem)]"
        : "pb-8 sm:pb-12",
    ]}
  >
    <slot />
  </main>
  <slot name="after" />
</BaseLayout>
