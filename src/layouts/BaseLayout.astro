---
import "@/styles/global.css";

type Props = {
  title: string;
  description?: string;
};

const { title, description = "Sermon recordings from Curt Dalaba." } =
  Astro.props;
const fullTitle = title === "Curt Dalaba" ? title : `${title} · Curt Dalaba`;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="theme-color"
      content="#fbfcfd"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#111418"
      media="(prefers-color-scheme: dark)"
    />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Curt Dalaba" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icons/icon-192.png" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <title>{fullTitle}</title>
    <!-- Runs before first paint so a saved theme never flashes the wrong colors. -->
    <script is:inline>
      try {
        const theme = localStorage.getItem("theme");
        if (theme === "light" || theme === "dark") {
          document.documentElement.dataset.theme = theme;
        }
      } catch {}
    </script>
  </head>
  <body class="flex min-h-dvh flex-col">
    <slot />
    <script>
      if ("serviceWorker" in navigator) {
        navigator.serviceWorker.register("/sw.js").catch(error => {
          console.warn("Service worker registration failed", error);
        });
      }
    </script>
  </body>
</html>
