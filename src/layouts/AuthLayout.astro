---
import Logo from "@/components/Logo.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";

type Props = {
  title: string;
  heading: string;
  intro?: string;
};

const { title, heading, intro } = Astro.props;
---

<BaseLayout title={title}>
  <main
    class="mx-auto flex w-full max-w-sm flex-1 flex-col justify-center px-4 py-12"
  >
    <div class="flex flex-col items-center text-center">
      <Logo class="size-14" />
      <p class="mt-4 text-muted-foreground text-sm">Curt Dalaba · Sermons</p>
      <h1 class="mt-2 font-semibold text-2xl tracking-tight">{heading}</h1>
      {intro && <p class="mt-2 text-muted-foreground leading-7">{intro}</p>}
    </div>
    <div class="mt-8 rounded-xl border bg-surface p-6 text-surface-foreground">
      <slot />
    </div>
    <div class="mt-6 text-center text-muted-foreground text-sm">
      <slot name="footer" />
    </div>
  </main>
</BaseLayout>
