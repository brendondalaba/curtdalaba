---
import AuthLayout from "@/layouts/AuthLayout.astro";
---

<AuthLayout title="Forgot password" heading="Forgot your password?">
  <div class="flex flex-col gap-4 leading-7">
    <p>
      Ask one of the site's admins for a reset link. They can make one for you
      from the Admin page.
    </p>
    <p class="text-muted-foreground">
      Open the link on your phone or computer, choose a new password, and
      you're signed in. Each link works once and expires after 3 days.
    </p>
  </div>
  <Fragment slot="footer">
    <a href="/login" class="font-medium text-primary hover:underline"
      >Back to sign in</a
    >
  </Fragment>
</AuthLayout>
