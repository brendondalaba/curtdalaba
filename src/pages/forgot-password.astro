---
import Alert from "@/components/Alert.astro";
import FormField from "@/components/FormField.astro";
import SubmitButton from "@/components/SubmitButton.astro";
import AuthLayout from "@/layouts/AuthLayout.astro";
import { formString, isWithinAuthRateLimit } from "@/lib/auth";

let error: string | null = null;
let sent = false;

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const email = formString(form, "email");

  if (!(await isWithinAuthRateLimit(Astro.request, "forgot"))) {
    error = "Too many attempts. Wait a minute and try again.";
  } else if (!email) {
    error = "Enter your email.";
  } else {
    const redirectTo = new URL(
      "/auth/callback?next=/reset-password",
      Astro.url
    ).toString();
    // Same message whether or not the account exists, so emails can't be probed.
    await Astro.locals.supabase.auth.resetPasswordForEmail(email, {
      redirectTo,
    });
    sent = true;
  }
}
---

<AuthLayout
  title="Reset password"
  heading="Reset your password"
  intro="We'll email you a link to choose a new one."
>
  {
    sent ? (
      <p role="status" class="leading-7">
        If that email has an account, a reset link is on its way. Open it on
        this device.
      </p>
    ) : (
      <form method="post" class="flex flex-col gap-4">
        <Alert message={error} />
        <FormField
          label="Email"
          name="email"
          type="email"
          autocomplete="username"
          inputmode="email"
          autocapitalize="none"
          spellcheck="false"
          required
        />
        <SubmitButton pendingLabel="Sending…">Send reset link</SubmitButton>
      </form>
    )
  }
  <Fragment slot="footer">
    <a href="/login" class="font-medium text-primary hover:underline"
      >Back to sign in</a
    >
  </Fragment>
</AuthLayout>
