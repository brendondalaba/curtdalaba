---
import Alert from "@/components/Alert.astro";
import FormField from "@/components/FormField.astro";
import PasswordToggle from "@/components/PasswordToggle.astro";
import SubmitButton from "@/components/SubmitButton.astro";
import AuthLayout from "@/layouts/AuthLayout.astro";
import { formPassword, MIN_PASSWORD_LENGTH } from "@/lib/auth";

// Reached through the emailed link (/auth/callback signs the member in first).
let error: string | null = null;

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const password = formPassword(form, "new-password");

  if (password.length < MIN_PASSWORD_LENGTH) {
    error = `Use a password of at least ${MIN_PASSWORD_LENGTH} characters.`;
  } else {
    const { error: updateError } = await Astro.locals.supabase.auth.updateUser(
      { password }
    );
    if (!updateError) return Astro.redirect("/?password=updated", 303);
    error =
      updateError.code === "same_password"
        ? "That's your current password. Choose a new one."
        : "We couldn't update your password. Try again.";
  }
  Astro.response.status = 400;
}
---

<AuthLayout title="New password" heading="Choose a new password">
  <form method="post" class="flex flex-col gap-4">
    <Alert message={error} />
    <input
      type="email"
      name="email"
      autocomplete="username"
      value={Astro.locals.user?.email}
      hidden
      readonly
    />
    <div class="flex flex-col gap-2">
      <FormField
        label="New password"
        name="new-password"
        type="password"
        autocomplete="new-password"
        minlength={MIN_PASSWORD_LENGTH}
        hint={`At least ${MIN_PASSWORD_LENGTH} characters.`}
        required
      />
      <PasswordToggle for="new-password" />
    </div>
    <SubmitButton pendingLabel="Saving…">Save password</SubmitButton>
  </form>
</AuthLayout>
