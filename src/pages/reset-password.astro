---
import { env } from "cloudflare:workers";
import Alert from "@/components/Alert.astro";
import FormField from "@/components/FormField.astro";
import PasswordToggle from "@/components/PasswordToggle.astro";
import SubmitButton from "@/components/SubmitButton.astro";
import AuthLayout from "@/layouts/AuthLayout.astro";
import {
  formPassword,
  isWithinAuthRateLimit,
  MIN_PASSWORD_LENGTH,
} from "@/lib/auth";
import { hashPassword } from "@/lib/password";
import {
  endOtherSessions,
  findPasswordReset,
  startSession,
} from "@/lib/session";

// Reached through a one-time link an admin made on the Admin page.
const token = Astro.url.searchParams.get("token") ?? "";
let error: string | null = null;

if (!(await isWithinAuthRateLimit(Astro.request, "reset"))) {
  Astro.response.status = 429;
  error = "Too many attempts. Wait a minute and try again.";
}

const member = error ? null : await findPasswordReset(token);

if (member && Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const password = formPassword(form, "new-password");

  if (password.length < MIN_PASSWORD_LENGTH) {
    error = `Use a password of at least ${MIN_PASSWORD_LENGTH} characters.`;
    Astro.response.status = 400;
  } else {
    await env.DB.batch([
      env.DB.prepare("update users set password_hash = ? where id = ?").bind(
        await hashPassword(password),
        member.id
      ),
      env.DB.prepare("delete from password_resets where user_id = ?").bind(
        member.id
      ),
    ]);
    // Sign out every other device, then sign in here.
    await endOtherSessions(member.id);
    await startSession(Astro.cookies, Astro.url, member.id);
    return Astro.redirect("/?password=updated", 303);
  }
}

if (!member && !error) Astro.response.status = 404;
---

<AuthLayout title="New password" heading="Choose a new password">
  {
    member ? (
      <form method="post" class="flex flex-col gap-6">
        <Alert message={error} />
        <input
          type="email"
          name="email"
          autocomplete="username"
          value={member.email}
          hidden
          readonly
        />
        <p class="text-muted-foreground">For {member.email}</p>
        <div class="flex flex-col gap-2">
          <FormField
            label="New password"
            name="new-password"
            type="password"
            autocomplete="new-password"
            minlength={MIN_PASSWORD_LENGTH}
            hint={`At least ${MIN_PASSWORD_LENGTH} characters.`}
            required
          />
          <PasswordToggle for="new-password" />
        </div>
        <SubmitButton pendingLabel="Saving…">Save password</SubmitButton>
      </form>
    ) : (
      <div class="flex flex-col gap-4">
        <Alert message={error} />
        {!error && (
          <p class="leading-7">
            This link has expired or was already used. Ask an admin for a new
            one.
          </p>
        )}
      </div>
    )
  }
  <Fragment slot="footer">
    <a href="/login" class="font-medium text-primary hover:underline"
      >Back to sign in</a
    >
  </Fragment>
</AuthLayout>
