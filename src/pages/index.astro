---
import { env } from "cloudflare:workers";
import Alert from "@/components/Alert.astro";
import Player from "@/components/Player.astro";
import AppLayout from "@/layouts/AppLayout.astro";
import type { ProgressRow, SermonListItem } from "@/lib/db";
import { formatDuration, formatSermonDate } from "@/lib/format";
import { inputClass, labelClass } from "@/lib/ui";

const { user, isAdmin } = Astro.locals;

let sermons: SermonListItem[] = [];
let progressRows: ProgressRow[] = [];
let error = false;
try {
  const [sermonResult, progressResult] = await env.DB.batch([
    env.DB.prepare(
      `select id, title, scripture, preached_on, duration_seconds from sermons
        order by preached_on desc, created_at desc`
    ),
    env.DB.prepare(
      `select sermon_id, position_seconds, completed, favorite, updated_at from playback_progress
        where user_id = ?`
    ).bind(user?.id ?? ""),
  ]);
  sermons = (sermonResult?.results ?? []) as SermonListItem[];
  progressRows = (progressResult?.results ?? []) as ProgressRow[];
} catch (caught) {
  console.error("Couldn't load sermons", caught);
  error = true;
}

const progress = new Map(progressRows.map(row => [row.sermon_id, row]));

const list = sermons.map((sermon, order) => {
  const saved = progress.get(sermon.id);
  const duration = sermon.duration_seconds ?? 0;
  const position = saved?.position_seconds ?? 0;
  const completed = saved?.completed === 1;
  const date = formatSermonDate(sermon.preached_on);
  const fraction = completed
    ? 1
    : duration > 0
      ? Math.min(1, position / duration)
      : 0;
  return {
    ...sermon,
    date,
    order,
    favorite: saved?.favorite === 1,
    listenedAt: saved?.updated_at ?? "",
    year: sermon.preached_on.slice(0, 4),
    duration,
    position,
    completed,
    fraction,
    subtitle: [sermon.scripture, date].filter(Boolean).join(" · "),
    progressLabel: completed
      ? "Played"
      : position > 0 && duration > 0
        ? `${formatDuration(duration - position)} left`
        : "",
    search: [sermon.title, sermon.scripture, date]
      .filter(Boolean)
      .join(" ")
      .toLowerCase(),
  };
});

// Most recently played first, so the sermon you were just on is on top.
const inProgress = list
  .filter(sermon => !sermon.completed && sermon.position > 0)
  .sort((a, b) => b.listenedAt.localeCompare(a.listenedAt));
const unplayed = list.filter(
  sermon => !sermon.completed && sermon.position <= 0
);
// Favorites first; otherwise newest first, as in the full list.
const played = list
  .filter(sermon => sermon.completed)
  .sort((a, b) => Number(b.favorite) - Number(a.favorite) || a.order - b.order);
// All three render (empty ones hidden) so rows can move between them live.
const sections = [
  { id: "continue", heading: "Continue listening", sermons: inProgress },
  {
    id: "unplayed",
    heading: "Not yet played",
    sermons: unplayed,
  },
  { id: "played", heading: "Played", sermons: played },
];

const years = [...new Set(list.map(sermon => sermon.year))];
const passwordUpdated = Astro.url.searchParams.get("password") === "updated";
---

<AppLayout title="Sermons" hasPlayer>
  <div class="flex flex-col gap-2">
    <h1 class="font-semibold text-3xl tracking-tight">Sermons</h1>
    <p class="text-muted-foreground">
      {list.length === 1 ? "1 recording" : `${list.length} recordings`}
    </p>
  </div>

  {
    passwordUpdated && (
      <div class="mt-6">
        <Alert tone="success" message="Your password has been updated." />
      </div>
    )
  }
  {
    error && (
      <div class="mt-6">
        <Alert message="Sermons couldn't be loaded. Refresh to try again." />
      </div>
    )
  }

  {
    list.length > 0 && (
      <search class="mt-8 block">
      <form
        class="grid gap-3 sm:grid-cols-[1fr_auto]"
        data-sermon-filter
      >
        <div class="flex flex-col gap-2">
          <label for="sermon-search" class={labelClass}>
            Search
          </label>
          <input
            id="sermon-search"
            name="q"
            type="search"
            autocomplete="off"
            placeholder="Title or passage, e.g. Romans"
            class={inputClass}
          />
        </div>
        {years.length > 1 && (
          <div class="flex flex-col gap-2">
            <label for="sermon-year" class={labelClass}>
              Year
            </label>
            <select
              id="sermon-year"
              name="year"
              autocomplete="off"
              class={`${inputClass} sm:w-36`}
            >
              <option value="">All years</option>
              {years.map(year => (
                <option value={year}>{year}</option>
              ))}
            </select>
          </div>
        )}
      </form>
      </search>
    )
  }

  {
    sections.map(section => (
      <section
        aria-labelledby={`${section.id}-heading`}
        hidden={section.sermons.length === 0}
        class="mt-8 flex flex-col gap-3"
        data-sermon-section={section.id}
      >
        <h2 id={`${section.id}-heading`} class="font-medium text-lg">
          {section.heading}
        </h2>
        <ul class="flex flex-col gap-3" data-sermon-list={section.id}>
          {section.sermons.map(sermon => (
            <li
              data-sermon-id={sermon.id}
              data-title={sermon.title}
              data-subtitle={sermon.subtitle}
              data-duration={sermon.duration}
              data-position={sermon.position}
              data-completed={String(sermon.completed)}
              data-favorite={String(sermon.favorite)}
              data-order={sermon.order}
              data-state={section.id}
              data-search={sermon.search}
              data-year={sermon.year}
              class="group overflow-hidden rounded-lg border bg-surface text-surface-foreground transition-colors duration-150 data-active:border-primary"
            >
              <div class="flex items-stretch">
                <button
                  type="button"
                  data-play-sermon
                  class="flex min-w-0 flex-1 items-center gap-4 p-4 text-left transition-colors duration-150 hover:bg-accent/50"
                >
                  <span class="inline-flex size-11 shrink-0 items-center justify-center rounded-full bg-secondary text-secondary-foreground group-data-active:bg-primary group-data-active:text-primary-foreground">
                    <svg viewBox="0 0 24 24" class="size-5" aria-hidden="true">
                      <path d="M8 5.5v13l10.5-6.5L8 5.5Z" fill="currentColor" />
                    </svg>
                    <span data-play-label class="sr-only">
                      Play
                    </span>
                  </span>
                  <span class="flex min-w-0 flex-1 flex-col gap-1">
                    <span class="font-medium leading-6">{sermon.title}</span>
                    <span class="text-muted-foreground text-sm">
                      {sermon.scripture && (
                        <>
                          <span class="text-foreground">{sermon.scripture}</span>
                          <span aria-hidden="true"> · </span>
                        </>
                      )}
                      <time datetime={sermon.preached_on}>{sermon.date}</time>
                      {sermon.duration > 0 && (
                        <>
                          <span aria-hidden="true"> · </span>
                          {formatDuration(sermon.duration)}
                        </>
                      )}
                    </span>
                    <span
                      data-progress-label
                      class="text-primary text-xs empty:hidden"
                    >
                      {sermon.progressLabel}
                    </span>
                  </span>
                </button>
                <button
                  type="button"
                  data-mark-played
                  aria-label={`Mark "${sermon.title}" as played`}
                  title="Mark as played"
                  class="hidden w-12 shrink-0 items-center justify-center text-muted-foreground transition-colors duration-150 hover:bg-accent hover:text-accent-foreground group-data-[state=continue]:inline-flex"
                >
                  <svg
                    viewBox="0 0 24 24"
                    class="size-5"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M5 12.5l4.5 4.5L19 7.5" />
                  </svg>
                </button>
                <button
                  type="button"
                  data-favorite-toggle
                  aria-label={`Favorite "${sermon.title}"`}
                  aria-pressed={sermon.favorite ? "true" : "false"}
                  title="Favorite"
                  class="hidden w-12 shrink-0 items-center justify-center text-muted-foreground transition-colors duration-150 hover:bg-accent hover:text-accent-foreground aria-pressed:text-primary group-data-[state=played]:inline-flex"
                >
                  <svg
                    viewBox="0 0 24 24"
                    class="size-5 fill-none group-data-[favorite=true]:fill-current"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M12 3.5l2.6 5.3 5.8.8-4.2 4.1 1 5.8-5.2-2.7-5.2 2.7 1-5.8-4.2-4.1 5.8-.8L12 3.5Z" />
                  </svg>
                </button>
              </div>
              <div class="h-1 bg-muted" aria-hidden="true">
                <div
                  data-progress-bar
                  class="h-full bg-primary"
                  style={`width: ${sermon.fraction * 100}%`}
                />
              </div>
            </li>
          ))}
        </ul>
      </section>
    ))
  }

  <p
    data-sermon-empty
    hidden={list.length > 0}
    class="mt-6 rounded-lg border border-dashed p-8 text-center text-muted-foreground"
  >
    {
      list.length === 0 ? (
        isAdmin ? (
          <>
            No sermons yet.{" "}
            <a href="/admin" class="font-medium text-primary hover:underline">
              Upload the first one
            </a>
            .
          </>
        ) : (
          "No sermons yet. Check back soon."
        )
      ) : (
        "No sermons match your search."
      )
    }
  </p>

  <Player slot="after" />
</AppLayout>

<script>
  const form = document.querySelector<HTMLFormElement>("[data-sermon-filter]");
  const empty = document.querySelector<HTMLElement>("[data-sermon-empty]");
  const items = document.querySelectorAll<HTMLElement>("[data-sermon-id]");
  const sections = document.querySelectorAll<HTMLElement>(
    "[data-sermon-section]"
  );
  const playedList = document.querySelector<HTMLElement>(
    '[data-sermon-list="played"]'
  );

  /** Hides empty sections; "Not yet played" needs no heading when it's alone. */
  function renderSections() {
    let visible = 0;
    for (const section of sections) {
      section.hidden = !section.querySelector("li:not([hidden])");
      if (!section.hidden) visible++;
    }
    const unplayedHeading = document.getElementById("unplayed-heading");
    if (unplayedHeading) unplayedHeading.hidden = visible < 2;
  }

  function applyFilter() {
    let shown = 0;
    const data = form ? new FormData(form) : null;
    const words = String(data?.get("q") ?? "")
      .toLowerCase()
      .split(/\s+/)
      .filter(Boolean);
    const year = String(data?.get("year") ?? "");
    for (const item of items) {
      const haystack = item.dataset.search ?? "";
      const isMatch =
        (!year || item.dataset.year === year) &&
        words.every(word => haystack.includes(word));
      item.hidden = !isMatch;
      if (isMatch) shown++;
    }
    renderSections();
    if (empty && items.length > 0) empty.hidden = shown > 0;
  }

  /** Favorites first, then the original (newest first) order. */
  function placeInPlayed(item: HTMLElement) {
    if (!playedList) return;
    const rank = (row: HTMLElement) =>
      (row.dataset.favorite === "true" ? 0 : 1e6) +
      Number(row.dataset.order ?? 0);
    const before = [
      ...playedList.querySelectorAll<HTMLElement>("[data-sermon-id]"),
    ].find(row => row !== item && rank(row) > rank(item));
    playedList.insertBefore(item, before ?? null);
  }

  // Sent by the player when a sermon ends or is marked as played.
  document.addEventListener("sermon:played", event => {
    const id = (event as CustomEvent<string>).detail;
    const item = document.querySelector<HTMLElement>(
      `[data-sermon-id="${id}"]`
    );
    if (!item) return;
    item.dataset.completed = "true";
    item.dataset.position = "0";
    item.dataset.state = "played";
    const bar = item.querySelector<HTMLElement>("[data-progress-bar]");
    const label = item.querySelector<HTMLElement>("[data-progress-label]");
    if (bar) bar.style.width = "100%";
    if (label) label.textContent = "Played";
    placeInPlayed(item);
    renderSections();
  });

  document.addEventListener("click", event => {
    const button = (event.target as Element | null)?.closest<HTMLElement>(
      "[data-favorite-toggle]"
    );
    const item = button?.closest<HTMLElement>("[data-sermon-id]");
    if (!button || !item) return;
    const favorite = item.dataset.favorite !== "true";
    const apply = (value: boolean) => {
      item.dataset.favorite = String(value);
      button.setAttribute("aria-pressed", String(value));
      placeInPlayed(item);
    };
    apply(favorite);
    fetch("/api/favorite", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ sermonId: item.dataset.sermonId, favorite }),
    })
      .then(response => {
        if (!response.ok) apply(!favorite);
      })
      .catch(() => apply(!favorite));
  });

  form?.addEventListener("input", applyFilter);
  form?.addEventListener("submit", event => {
    event.preventDefault();
    applyFilter();
  });
  renderSections();
</script>
