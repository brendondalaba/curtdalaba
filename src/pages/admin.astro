---
import { env } from "cloudflare:workers";
import Alert from "@/components/Alert.astro";
import UploadSermon from "@/components/UploadSermon.astro";
import AppLayout from "@/layouts/AppLayout.astro";
import { formString, normalizeAccessCode } from "@/lib/auth";
import { type Member, nowIso, type SermonListItem } from "@/lib/db";
import { formatDuration, formatSermonDate } from "@/lib/format";
import { isUuid, sermonAudioKey } from "@/lib/sermons";
import { createPasswordReset, endOtherSessions } from "@/lib/session";
import {
  buttonDanger,
  buttonPrimary,
  buttonSecondary,
  cardClass,
  inputClass,
  labelClass,
} from "@/lib/ui";

const { user, isAdmin } = Astro.locals;
if (!isAdmin) return Astro.redirect("/");
const db = env.DB;

const NOTICES: Record<string, string> = {
  uploaded: "Sermon uploaded.",
  saved: "Sermon updated.",
  deleted: "Sermon deleted.",
  code: "Access code changed. Existing members aren't affected.",
  admin: "Member updated.",
  removed: "Member removed.",
};

let error: string | null = null;
/** Shown once, right after an admin makes it; never put in a URL or stored. */
let resetLink = null as { email: string; url: string } | null;

class AdminError extends Error {}

async function handle(form: FormData): Promise<string | null> {
  const intent = formString(form, "intent");
  const id = formString(form, "id");

  if (intent === "update-sermon") {
    const title = formString(form, "title");
    const scripture = formString(form, "scripture");
    if (!isUuid(id)) throw new AdminError("Unknown sermon.");
    if (!title || title.length > 200) throw new AdminError("Add a title.");
    if (scripture.length > 200) throw new AdminError("Scripture is too long.");
    await db
      .prepare(
        "update sermons set title = ?, scripture = ? where id = ?"
      )
      .bind(title, scripture || null, id)
      .run();
    return "saved";
  }

  if (intent === "delete-sermon") {
    if (!isUuid(id)) throw new AdminError("Unknown sermon.");
    await db.prepare("delete from sermons where id = ?").bind(id).run();
    await env.SERMONS_BUCKET.delete(sermonAudioKey(id));
    return "deleted";
  }

  if (intent === "access-code") {
    const code = normalizeAccessCode(formString(form, "access_code"));
    if (code.length < 6 || code.length > 64) {
      throw new AdminError("Use 6 to 64 letters or numbers.");
    }
    await db
      .prepare(
        "update app_settings set access_code = ?, updated_at = ? where id = 1"
      )
      .bind(code, nowIso())
      .run();
    return "code";
  }

  if (!isUuid(id)) throw new AdminError("Unknown member.");
  if (id === user?.id) {
    throw new AdminError(
      "You can't change your own account here. Use the Account page."
    );
  }

  if (intent === "set-admin") {
    await db
      .prepare("update users set is_admin = ? where id = ?")
      .bind(formString(form, "value") === "true" ? 1 : 0, id)
      .run();
    return "admin";
  }

  if (intent === "remove-member") {
    // Their sessions, reset links and progress go with them (on delete cascade).
    await db.prepare("delete from users where id = ?").bind(id).run();
    return "removed";
  }

  if (intent === "reset-link") {
    const member = await db
      .prepare("select email from users where id = ?")
      .bind(id)
      .first<{ email: string }>();
    if (!member) throw new AdminError("Unknown member.");
    const token = await createPasswordReset(id);
    // A forgotten password often means a lost or shared device: sign them out.
    await endOtherSessions(id);
    const url = new URL("/reset-password", Astro.url);
    url.searchParams.set("token", token);
    resetLink = { email: member.email, url: url.toString() };
    return null;
  }

  throw new AdminError("Unknown action.");
}

if (Astro.request.method === "POST") {
  try {
    const notice = await handle(await Astro.request.formData());
    if (notice) return Astro.redirect(`/admin?notice=${notice}`, 303);
  } catch (caught) {
    if (!(caught instanceof AdminError)) console.error(caught);
    error =
      caught instanceof AdminError
        ? caught.message
        : "Something went wrong. Try again.";
    Astro.response.status = 400;
  }
}

const notice = NOTICES[Astro.url.searchParams.get("notice") ?? ""] ?? null;

const [sermonResult, memberResult, settingsResult] = await db.batch([
  db.prepare(
    `select id, title, scripture, preached_on, duration_seconds from sermons
      order by preached_on desc, created_at desc`
  ),
  db.prepare(
    `select id, email, full_name, is_admin, created_at from users
      order by created_at`
  ),
  db.prepare("select access_code from app_settings where id = 1"),
]);
const sermons = (sermonResult?.results ?? []) as SermonListItem[];
const members = (memberResult?.results ?? []) as Member[];
const settings = settingsResult?.results?.[0] as
  | { access_code: string }
  | undefined;

const joined = new Intl.DateTimeFormat("en-US", { dateStyle: "medium" });
---

<AppLayout title="Admin">
  <h1 class="font-semibold text-2xl tracking-tight">Admin</h1>

  {
    (error || notice) && (
      <div class="mt-6 flex flex-col gap-3">
        <Alert message={error} />
        <Alert tone="success" message={notice} />
      </div>
    )
  }

  {
    resetLink && (
      <section
        class={`${cardClass} mt-6 border-primary`}
        aria-labelledby="reset-heading"
      >
        <h2 id="reset-heading" class="font-semibold leading-none">
          Reset link for {resetLink.email}
        </h2>
        <p class="mt-1.5 text-muted-foreground">
          Send this to them by text or email. It works once, for 3 days, and
          won't be shown again.
        </p>
        <div class="mt-4 flex flex-col gap-3 sm:flex-row">
          <label for="reset-url" class="sr-only">
            Reset link
          </label>
          <input
            id="reset-url"
            type="text"
            readonly
            value={resetLink.url}
            autocomplete="off"
            spellcheck="false"
            class={`${inputClass} flex-1 font-mono text-sm`}
          />
          <button
            type="button"
            class={buttonPrimary}
            data-copy-target="reset-url"
          >
            Copy link
          </button>
        </div>
      </section>
    )
  }

  <div class="mt-8 flex flex-col gap-6">
    <section class={cardClass} aria-labelledby="upload-heading">
      <h2 id="upload-heading" class="font-semibold leading-none">Upload a sermon</h2>
      <UploadSermon />
    </section>

    <section class={cardClass} aria-labelledby="code-heading">
      <h2 id="code-heading" class="font-semibold leading-none">Access code</h2>
      <p class="mt-1.5 text-muted-foreground">
        New members enter this once when they create an account. Changing it
        doesn't sign anyone out.
      </p>
      <p class="mt-4">
        Current code:
        <span
          class="rounded-md bg-muted px-2 py-1 font-medium font-mono tracking-wider"
          >{settings?.access_code ?? "—"}</span
        >
      </p>
      <form
        method="post"
        class="mt-6 flex flex-col gap-3 sm:flex-row sm:items-end"
      >
        <input type="hidden" name="intent" value="access-code" />
        <div class="flex flex-1 flex-col gap-2">
          <label for="access-code" class={labelClass}>New code</label>
          <input
            id="access-code"
            name="access_code"
            type="text"
            minlength="6"
            maxlength="64"
            autocomplete="off"
            autocapitalize="characters"
            spellcheck="false"
            required
            class={inputClass}
          />
        </div>
        <button type="submit" class={buttonPrimary}>Change code</button>
      </form>
    </section>

    <section class={cardClass} aria-labelledby="sermons-heading">
      <h2 id="sermons-heading" class="font-semibold leading-none">
        Sermons ({sermons?.length ?? 0})
      </h2>
      <ul class="mt-6 flex flex-col divide-y">
        {
          (sermons ?? []).map(sermon => (
            <li class="py-3">
              <details class="group">
                <summary class="flex cursor-pointer list-none items-start justify-between gap-4 rounded-md">
                  <span class="min-w-0">
                    <span class="block font-medium">{sermon.title}</span>
                    <span class="block text-muted-foreground text-sm">
                      {[
                        sermon.scripture,
                        formatSermonDate(sermon.preached_on),
                        sermon.duration_seconds
                          ? formatDuration(sermon.duration_seconds)
                          : null,
                      ]
                        .filter(Boolean)
                        .join(" · ")}
                    </span>
                  </span>
                  <span class="shrink-0 font-medium text-primary text-sm group-open:hidden">
                    Edit
                  </span>
                  <span class="hidden shrink-0 font-medium text-primary text-sm group-open:inline">
                    Close
                  </span>
                </summary>
                <form method="post" class="mt-4 grid gap-3 sm:grid-cols-2">
                  <input type="hidden" name="id" value={sermon.id} />
                  <div class="flex flex-col gap-2 sm:col-span-2">
                    <label for={`title-${sermon.id}`} class={labelClass}>
                      Title
                    </label>
                    <input
                      id={`title-${sermon.id}`}
                      name="title"
                      value={sermon.title}
                      maxlength="200"
                      autocomplete="off"
                      required
                      class={inputClass}
                    />
                  </div>
                  <div class="flex flex-col gap-2 sm:col-span-2">
                    <label for={`scripture-${sermon.id}`} class={labelClass}>
                      Scripture (optional)
                    </label>
                    <input
                      id={`scripture-${sermon.id}`}
                      name="scripture"
                      value={sermon.scripture ?? ""}
                      maxlength="200"
                      autocomplete="off"
                      class={inputClass}
                    />
                  </div>
                  <div class="flex flex-wrap gap-3 sm:col-span-2">
                    <button
                      type="submit"
                      name="intent"
                      value="update-sermon"
                      class={buttonPrimary}
                    >
                      Save
                    </button>
                    <button
                      type="submit"
                      name="intent"
                      value="delete-sermon"
                      formnovalidate
                      data-confirm={`Delete "${sermon.title}"? The recording is removed for everyone.`}
                      class={buttonDanger}
                    >
                      Delete
                    </button>
                  </div>
                </form>
              </details>
            </li>
          ))
        }
      </ul>
    </section>

    <section class={cardClass} aria-labelledby="members-heading">
      <h2 id="members-heading" class="font-semibold leading-none">
        Members ({members?.length ?? 0})
      </h2>
      <ul class="mt-6 flex flex-col divide-y">
        {
          (members ?? []).map(member => (
            <li class="flex flex-col gap-3 py-3 sm:flex-row sm:items-center sm:justify-between">
              <div class="min-w-0">
                <p class="font-medium">
                  {member.full_name ?? member.email}
                  {member.is_admin === 1 && (
                    <span class="ml-2 rounded-full bg-accent px-2 py-0.5 font-medium text-accent-foreground text-xs">
                      Admin
                    </span>
                  )}
                </p>
                <p class="truncate text-muted-foreground text-sm">
                  {member.email} · joined{" "}
                  {joined.format(new Date(member.created_at))}
                </p>
              </div>
              {member.id !== user?.id && (
                <form method="post" class="flex shrink-0 flex-wrap gap-2">
                  <input type="hidden" name="id" value={member.id} />
                  <input
                    type="hidden"
                    name="value"
                    value={String(member.is_admin !== 1)}
                  />
                  <button
                    type="submit"
                    name="intent"
                    value="reset-link"
                    data-confirm={`Make a password reset link for ${member.email}? They'll be signed out on their devices until they use it.`}
                    class={`${buttonSecondary} h-9 text-sm`}
                  >
                    Reset link
                  </button>
                  <button
                    type="submit"
                    name="intent"
                    value="set-admin"
                    class={`${buttonSecondary} h-9 text-sm`}
                  >
                    {member.is_admin === 1 ? "Remove admin" : "Make admin"}
                  </button>
                  <button
                    type="submit"
                    name="intent"
                    value="remove-member"
                    data-confirm={`Remove ${member.email}? They'll need the access code to sign up again.`}
                    class={`${buttonDanger} h-9 text-sm`}
                  >
                    Remove
                  </button>
                </form>
              )}
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</AppLayout>

<script>
  // Ask before destructive actions.
  document.addEventListener("click", event => {
    const button = (event.target as Element | null)?.closest<HTMLElement>(
      "[data-confirm]"
    );
    if (button && !window.confirm(button.dataset.confirm ?? "Are you sure?")) {
      event.preventDefault();
    }
  });

  // Copy the one-time reset link.
  for (const button of document.querySelectorAll<HTMLButtonElement>(
    "[data-copy-target]"
  )) {
    const input = document.getElementById(button.dataset.copyTarget ?? "");
    if (!(input instanceof HTMLInputElement)) continue;
    input.addEventListener("focus", () => input.select());
    button.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(input.value);
        button.textContent = "Copied";
      } catch {
        input.focus();
        button.textContent = "Select and copy";
      }
    });
  }
</script>
