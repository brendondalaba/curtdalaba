---
import { env } from "cloudflare:workers";
import Alert from "@/components/Alert.astro";
import FormField from "@/components/FormField.astro";
import InstallApp from "@/components/InstallApp.astro";
import PasswordToggle from "@/components/PasswordToggle.astro";
import SubmitButton from "@/components/SubmitButton.astro";
import ThemeToggle from "@/components/ThemeToggle.astro";
import AppLayout from "@/layouts/AppLayout.astro";
import {
  formPassword,
  isWithinAuthRateLimit,
  MIN_PASSWORD_LENGTH,
} from "@/lib/auth";
import { hashPassword, verifyPassword } from "@/lib/password";
import { endOtherSessions } from "@/lib/session";
import { buttonSecondary, cardClass } from "@/lib/ui";

const { user } = Astro.locals;
let passwordError: string | null = null;
let passwordSaved = false;

async function changePassword(form: FormData) {
  if (!user) return "Sign in again.";
  const current = formPassword(form, "current-password");
  const password = formPassword(form, "new-password");
  if (!(await isWithinAuthRateLimit(Astro.request, "password"))) {
    return "Too many attempts. Wait a minute and try again.";
  }
  if (password.length < MIN_PASSWORD_LENGTH) {
    return `Use a password of at least ${MIN_PASSWORD_LENGTH} characters.`;
  }
  if (password === current) {
    return "That's your current password. Choose a new one.";
  }
  const row = await env.DB.prepare(
    "select password_hash from users where id = ?"
  )
    .bind(user.id)
    .first<{ password_hash: string }>();
  const { valid } = await verifyPassword(current, row?.password_hash ?? null);
  if (!valid) return "Your current password isn't right.";

  await env.DB.prepare("update users set password_hash = ? where id = ?")
    .bind(await hashPassword(password), user.id)
    .run();
  // Keep this device signed in; sign out every other one.
  await endOtherSessions(user.id, Astro.cookies);
  return null;
}

if (Astro.request.method === "POST") {
  passwordError = await changePassword(await Astro.request.formData());
  if (passwordError) Astro.response.status = 400;
  else passwordSaved = true;
}
---

<AppLayout title="Account">
  <h1 class="font-semibold text-3xl tracking-tight">Account</h1>

  <div class="mt-8 flex flex-col gap-6">
    <section class={cardClass} aria-labelledby="profile-heading">
      <h2 id="profile-heading" class="font-medium text-lg">Signed in as</h2>
      {user?.fullName && <p class="mt-2">{user.fullName}</p>}
      <p class="text-muted-foreground">{user?.email}</p>
      <form method="post" action="/logout" class="mt-4">
        <button type="submit" class={buttonSecondary}>Sign out</button>
      </form>
    </section>

    <section class={cardClass} aria-labelledby="install-heading">
      <h2 id="install-heading" class="mb-2 font-medium text-lg">
        Get the app
      </h2>
      <InstallApp />
    </section>

    <section class={cardClass} aria-labelledby="password-heading">
      <h2 id="password-heading" class="font-medium text-lg">Change password</h2>
      <form method="post" class="mt-4 flex max-w-sm flex-col gap-4">
        <Alert message={passwordError} />
        <Alert
          tone="success"
          message={passwordSaved ? "Password updated." : null}
        />
        <input
          type="email"
          name="email"
          autocomplete="username"
          value={user?.email}
          hidden
          readonly
        />
        <div class="flex flex-col gap-2">
          <FormField
            label="Current password"
            name="current-password"
            type="password"
            autocomplete="current-password"
            required
          />
          <PasswordToggle for="current-password" />
        </div>
        <div class="flex flex-col gap-2">
          <FormField
            label="New password"
            name="new-password"
            type="password"
            autocomplete="new-password"
            minlength={MIN_PASSWORD_LENGTH}
            hint={`At least ${MIN_PASSWORD_LENGTH} characters.`}
            required
          />
          <PasswordToggle for="new-password" />
        </div>
        <SubmitButton pendingLabel="Saving…" class="sm:w-auto">
          Save password
        </SubmitButton>
      </form>
    </section>

    <section class={cardClass} aria-labelledby="theme-heading">
      <h2 id="theme-heading" class="font-medium text-lg">Appearance</h2>
      <p class="mt-2 mb-4 text-muted-foreground">
        Follow your device, or pick light or dark.
      </p>
      <ThemeToggle />
    </section>
  </div>
</AppLayout>
