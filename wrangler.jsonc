{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "curtdalaba",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  // Private bucket: no public access, no r2.dev URL. Audio is only served by
  // /api/audio/[id] after the login check in src/middleware.ts.
  "r2_buckets": [
    {
      "binding": "SERMONS_BUCKET",
      "bucket_name": "curtdalaba-sermons"
    }
  ],
  // Members, sessions, sermons and progress. Schema: migrations/ (applied with
  // `npx wrangler d1 migrations apply curtdalaba --remote`).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "curtdalaba",
      "database_id": "60aaea84-037f-4cd7-853c-1e5f551a7b44"
    }
  ],
  // Slows down guessing passwords and the access code: 10 attempts per minute per IP.
  "ratelimits": [
    {
      "name": "AUTH_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ]
}
